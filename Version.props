<Project>
    <!-- Centralized semantic version properties -->
    <PropertyGroup>
        <!-- Major.Minor.Patch — synced manually before each release; CI overrides at pack time
             via -p:Version=${tag}, so this only affects local `dotnet pack` output. Keep in sync
             with the latest tag to avoid producing stale-versioned packages locally. -->
        <VersionPrefix>5.4.3</VersionPrefix>

        <!-- Pre-release suffix (e.g., -beta1, -ci.123) -->
        <VersionSuffix></VersionSuffix>

        <!-- Effective Version -->
        <Version Condition="'$(Version)' == '' and '$(VersionSuffix)' == ''">$(VersionPrefix)</Version>
        <Version Condition="'$(Version)' == '' and '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>

        <!-- Derived versions -->
        <PackageVersion>$(Version)</PackageVersion>
        <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
        <FileVersion>$(Version)</FileVersion>
        <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>

    <!-- Dependency versions -->
    <PropertyGroup>
        <!-- renovate: datasource=nuget depName=Meziantou.Analyzer -->
        <MeziantouAnalyzerVersion>3.0.190</MeziantouAnalyzerVersion>
        <!-- renovate: datasource=nuget depName=ANcpLua.Roslyn.Utilities -->
        <ANcpLuaRoslynUtilitiesVersion>3.0.1</ANcpLuaRoslynUtilitiesVersion>
        <!-- renovate: datasource=nuget depName=Microsoft.CodeAnalysis.Analyzers -->
        <MicrosoftCodeAnalysisAnalyzersVersion>5.9.0</MicrosoftCodeAnalysisAnalyzersVersion>
        <!-- renovate: datasource=nuget depName=Microsoft.CodeAnalysis.CSharp -->
        <MicrosoftCodeAnalysisCSharpVersion>5.9.0</MicrosoftCodeAnalysisCSharpVersion>
        <!-- renovate: datasource=nuget depName=ErrorProne.NET.CoreAnalyzers -->
        <ErrorProneNETCoreAnalyzersVersion>0.8.2-beta.1</ErrorProneNETCoreAnalyzersVersion>
        <!-- renovate: datasource=nuget depName=ErrorProne.NET.Structs -->
        <ErrorProneNETStructsVersion>0.6.1-beta.1</ErrorProneNETStructsVersion>
        <!-- renovate: datasource=nuget depName=Roslynator.Analyzers -->
        <RoslynatorAnalyzersVersion>4.15.0</RoslynatorAnalyzersVersion>
        <!-- renovate: datasource=nuget depName=JonSkeet.RoslynAnalyzers -->
        <JonSkeetRoslynAnalyzersVersion>1.0.0-beta.7</JonSkeetRoslynAnalyzersVersion>
        <!-- renovate: datasource=nuget depName=Microsoft.SourceLink.GitHub -->
        <MicrosoftSourceLinkGitHubVersion>10.0.400</MicrosoftSourceLinkGitHubVersion>
        <!-- renovate: datasource=nuget depName=Microsoft.Bcl.HashCode -->
        <MicrosoftBclHashCodeVersion>6.0.0</MicrosoftBclHashCodeVersion>
        <!-- renovate: datasource=nuget depName=Verify.XunitV3 -->
        <VerifyXunitV3Version>32.0.0</VerifyXunitV3Version>
        <!-- renovate: datasource=nuget depName=Microsoft.CodeAnalysis.CSharp.Analyzer.Testing -->
        <MicrosoftCodeAnalysisTestingVersion>1.1.4</MicrosoftCodeAnalysisTestingVersion>
        <!-- renovate: datasource=nuget depName=xunit.v3.mtp-v2 -->
        <XunitV3MtpV2Version>4.0.2</XunitV3MtpV2Version>
        <!-- ASP.NET Core packages follow the SDK's runtime servicing line (DotNetRuntimeVersion from ANcpLua.NET.Sdk). -->
        <MicrosoftAspNetCoreOpenApiVersion>$(DotNetRuntimeVersion)</MicrosoftAspNetCoreOpenApiVersion>
        <MicrosoftAspNetCoreMvcTestingVersion>$(DotNetRuntimeVersion)</MicrosoftAspNetCoreMvcTestingVersion>
        <MicrosoftAspNetCoreTestHostVersion>$(DotNetRuntimeVersion)</MicrosoftAspNetCoreTestHostVersion>
        <!-- renovate: datasource=nuget depName=Asp.Versioning.Http -->
        <AspVersioningHttpVersion>10.0.0</AspVersioningHttpVersion>
    </PropertyGroup>
</Project>
